# Copy to .env.local. Public values only. Never put the service-role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: let this app report its own errors to its own Codex Monitor project (see README, "Monitor Codex with Codex").
# This key is visible in the browser. Use a dedicated project with a low monthly cap.
VITE_SELF_MONITOR_KEY=
